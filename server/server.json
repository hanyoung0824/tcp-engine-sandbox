{
	"engine": {
		"transport": "tcp",
		"port": 12345,
		"heartbeat": { "interval": 10, "timeout": 30 },
		"session": { "resumeTimeout": 30 },
		"closeTimeout": 5,
		"sendQueueLimitKB": 1024,
		"receiveLimit": { "packetsPerSecond": 100 },
		"statsIntervalSeconds": 60
	},
	"app": {
		"noticeSender": "Server",
		"chatLimit": { "messages": 5, "perSeconds": 3 }
	},
	"log": {
		"engine": {
			"console": { "level": "info" },
			"_file": { "level": "debug", "path": "logs/engine.log", "maxSizeMB": 10, "maxFiles": 5 }
		},
		"app": {
			"console": { "level": "info" },
			"_file": { "level": "debug", "path": "logs/app.log", "maxSizeMB": 10, "maxFiles": 5 }
		}
	}
}
